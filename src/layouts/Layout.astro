---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  fullscreen?: boolean;
}

const {
  title = "TypeSHYTT.COM - Typing Speed Test (WPM) & Touch Typing Practice",
  description = "Boost your touch typing speed with a free WPM test, typing practice, and typing lessons. Fast, distraction-free, offline-first.",
  fullscreen = false,
} = Astro.props;

const canonicalUrl = (() => {
  try {
    return Astro.url?.toString?.() ?? "";
  } catch {
    return "";
  }
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="typing test online, typing speed test, WPM test, touch typing, keyboard trainer, typing practice, typing lessons, typing game, learn typing"
    />
    <meta name="robots" content="index, follow" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:site" content="@typeshytt" />

    <!-- Theme -->
    <meta name="theme-color" content="#000000" />

    <!-- Organization schema (global) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "TypeSHYTT.COM",
        "url": "https://typeshytt.com/",
        "sameAs": []
      }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Inline Script to prevent FOUC (Flash of Unstyled Content) for Dark Theme -->
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>

  <body
    class="flex flex-col min-h-screen bg-canvas-soft text-ink transition-colors duration-200"
  >
    {!fullscreen && <Navbar />}

    <main
      class={fullscreen
        ? "flex-1 flex flex-col h-screen overflow-hidden"
        : "flex-1 w-full max-w-[1400px] mx-auto px-6 md:px-8 py-8 md:py-12 flex flex-col justify-start"}
    >
      <slot />
    </main>

    {!fullscreen && <Footer />}
  </body>
</html>
