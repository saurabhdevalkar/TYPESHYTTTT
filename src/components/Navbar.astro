---
// src/components/Navbar.astro
---

<header
  class="sticky top-0 z-50 w-full h-16 bg-canvas border-b border-hairline transition-colors duration-200"
>
  <div
    class="max-w-[1400px] h-full mx-auto px-6 md:px-8 flex items-center justify-between"
  >
    <!-- Brand Logo -->
    <a
      href="/"
      class="flex items-center space-x-2 text-ink font-semibold tracking-tight text-lg"
    >
      <span
        class="bg-gradient-to-r from-gradient-develop-start to-gradient-preview-end text-transparent bg-clip-text font-bold text-xl"
        >⚡</span
      >
      <span>TypeSHYTT<span class="text-link">.COM</span></span>
    </a>

    <!-- Nav Links (Center) -->
    <nav
      class="hidden sm:flex items-center space-x-1 bg-canvas-soft-2 p-1 rounded-full border border-hairline"
    >
      <a
        href="/"
        class="nav-item px-4 py-1.5 rounded-full text-sm font-medium text-body hover:text-ink transition-colors"
        data-path="/"
      >
        Typing Test
      </a>
      <a
        href="/game"
        class="nav-item px-4 py-1.5 rounded-full text-sm font-medium text-body hover:text-ink transition-colors"
        data-path="/game"
      >
        Spaceship Game
      </a>
      <!-- Coding Speed removed -->
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center space-x-4">
      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        class="p-2 rounded-lg border border-hairline hover:bg-canvas-soft-2 text-body hover:text-ink transition-all cursor-pointer relative w-9 h-9 flex items-center justify-center"
        aria-label="Toggle Theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg
          id="theme-toggle-sun"
          class="hidden w-[18px] h-[18px]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 9h-1m14.071-7.071l-.707.707M6.343 17.657l-.707.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg
          id="theme-toggle-moon"
          class="hidden w-[18px] h-[18px]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- CTA Action -->
      <a
        href="/game"
        class="hidden md:inline-flex items-center justify-center px-4 h-8 text-xs font-semibold rounded-sm bg-primary text-on-primary hover:opacity-90 transition-opacity"
      >
        Play Free Game
      </a>
    </div>
  </div>

  <!-- Mobile Navigation Bar (Bottom overlay on small viewports) -->
  <div
    class="sm:hidden fixed bottom-0 left-0 right-0 bg-canvas border-t border-hairline py-2 px-6 flex justify-around items-center z-50 shadow-[0_-4px_12px_rgba(0,0,0,0.05)]"
  >
    <a
      href="/"
      class="flex flex-col items-center space-y-0.5 text-body hover:text-ink transition-colors"
    >
      <span class="text-lg">⌨️</span>
      <span class="text-[10px] font-medium">Test</span>
    </a>
    <a
      href="/game"
      class="flex flex-col items-center space-y-0.5 text-body hover:text-ink transition-colors"
    >
      <span class="text-lg">🚀</span>
      <span class="text-[10px] font-medium">Game</span>
    </a>
    <!-- Coding Speed removed -->
  </div>
</header>

<script>
  // Highlight active nav tab based on pathname
  const pathname = window.location.pathname;
  const navItems = document.querySelectorAll(".nav-item");
  navItems.forEach((item) => {
    const path = item.getAttribute("data-path");
    if (!path) return;

    if (path === pathname || (path !== "/" && pathname.startsWith(path))) {
      item.classList.remove("text-body");
      item.classList.add("bg-canvas", "text-ink", "shadow-vercel-sm");
    }
  });

  // Client-side theme controller
  const themeToggle = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("theme-toggle-sun");
  const moonIcon = document.getElementById("theme-toggle-moon");

  function updateToggleIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      sunIcon?.classList.remove("hidden");
      moonIcon?.classList.add("hidden");
    } else {
      sunIcon?.classList.add("hidden");
      moonIcon?.classList.remove("hidden");
    }
  }

  // Initial load alignment
  updateToggleIcons();

  // Click handler
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      document.documentElement.classList.remove("dark");
      localStorage.setItem("theme", "light");
    } else {
      document.documentElement.classList.add("dark");
      localStorage.setItem("theme", "dark");
    }
    updateToggleIcons();

    // Dispatch custom event to let canvas or game systems know theme changed
    window.dispatchEvent(new CustomEvent("theme-change"));
  });
</script>
